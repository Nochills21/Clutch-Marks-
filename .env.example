# Build-time variables for the Vite app. Copy to `.env` for local dev, and set
# the same three keys as build environment variables in Cloudflare Pages
# (Settings → Environment variables → Production) so CI builds embed them.
# These are public values: they ship inside the client bundle by design.
VITE_SUPABASE_PROJECT_ID="zzliiazovezhxbmfeqco"
VITE_SUPABASE_URL="https://zzliiazovezhxbmfeqco.supabase.co"
VITE_SUPABASE_PUBLISHABLE_KEY="<the publishable/anon key from the Supabase dashboard>"

# Optional: enables Plausible analytics when set (see docs/domain-launch-runbook.md)
# VITE_PLAUSIBLE_DOMAIN="clutchmarks.com"
