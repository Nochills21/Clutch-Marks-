# Build-time variables for the Vite app. Copy to `.env` for local dev, and set
# the same keys as build environment variables on the frontend host (Vercel →
# Settings → Environment variables) so CI builds embed them.
# These are public values: they ship inside the client bundle by design.
VITE_SUPABASE_URL="https://zzliiazovezhxbmfeqco.supabase.co"
VITE_SUPABASE_PUBLISHABLE_KEY="<the publishable/anon key from the Supabase dashboard>"

# Public origin override. Set to the live domain at build/deploy time:
# VITE_SITE_URL="https://clutchmarks.study"
# VITE_PLAUSIBLE_DOMAIN="clutchmarks.study"

# Optional stable API origin (Render backend, see docs/deploy-vercel-render.md).
# Leave empty to call Supabase edge functions directly as today:
# VITE_API_URL="https://clutchmarks-api.onrender.com"
