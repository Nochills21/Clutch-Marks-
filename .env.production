# Build-time config for production builds (Vercel runs `vite build`, mode
# production, from the repo root, so these values are inlined into the bundle).
#
# These are PUBLIC values by design: VITE_* variables ship inside the client
# JavaScript that every visitor downloads. The publishable/anon key is the
# client-side key — Row Level Security is what protects the data, not secrecy
# of this key. Never put a service_role key in a VITE_* variable.
#
# Real environment variables set in the Vercel dashboard take priority over
# this file, so the dashboard stays the place to rotate values without a
# commit. This file exists so a build can never silently produce an app with
# an undefined Supabase URL (which used to fail at runtime, not at build time).

VITE_SITE_URL="https://clutchmarks.study"
VITE_SUPABASE_URL="https://zzliiazovezhxbmfeqco.supabase.co"
VITE_SUPABASE_PUBLISHABLE_KEY="eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZSIsInJlZiI6Inp6bGlpYXpvdmV6aHhibWZlcWNvIiwicm9sZSI6ImFub24iLCJpYXQiOjE3ODczMjQ0MzksImV4cCI6MjEwMjkwMDQzOX0.5Ihi_QZWhV6KBieDcVuJVLVWgA8AS1dZxqMXa3rd6H4"
