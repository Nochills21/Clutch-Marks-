<?xml version="1.0" encoding="UTF-8"?>
<urlset xmlns="http://www.sitemaps.org/schemas/sitemap/0.9">
  <!-- Canonical, publicly reachable routes only. The previous sitemap listed
       client-side redirects (/homework, /revision, /heatmap, /smart-revision,
       /question-bank), a path with no route at all (/calendar -> 404), and the
       sign-in page (/auth), which is now noindex. Those are handled by 301
       redirects in vercel.json instead, so crawlers never index a redirect.

       /flashcards, /practice and /study-planner are deliberately absent too:
       they sit behind <ApprovalGate>, which redirects a signed-out visitor to
       /auth, so a crawl of one only ever sees that redirect. They carry
       noindex in ROUTE_META; seoConsistency.test.ts holds both halves of that
       rule to the route table.

       The 300 /study/:subject/:level/:topic/(notes|quiz|papers) URLs are NOT
       listed here: they depend on which topics the live database holds, and
       this file is checked in. plugins/prerender-seo.ts appends them at build
       time from the committed topic manifest, so the sitemap the site serves
       lists ~310 URLs while this file stays the literal-route fallback that
       seoConsistency.test.ts can check.

       <lastmod> is a freshness signal that makes Google recrawl the page and
       replace a stale result title. The prerender plugin refreshes it with the
       build date, so the checked-in value is only a fallback for local/static
       previews — either way it must stay a real date (YYYY-MM-DD). -->
  <url>
    <loc>https://clutchmarks.study/</loc>
    <lastmod>2026-10-07</lastmod>
    <changefreq>weekly</changefreq>
    <priority>1.0</priority>
  </url>
