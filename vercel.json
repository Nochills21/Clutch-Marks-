{
  "$schema": "https://vercel.com/schema/v6",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "framework": "vite",
  "rewrites": [{ "source": "/(.*)", "destination": "/spa-fallback.html" }],
  "redirects": [
    { "source": "/homework", "destination": "/quizzes", "permanent": true },
    { "source": "/revision", "destination": "/notes", "permanent": true },
    { "source": "/heatmap", "destination": "/progress", "permanent": true },
    { "source": "/review", "destination": "/practice", "permanent": true },
    { "source": "/smart-revision", "destination": "/practice", "permanent": true },
    { "source": "/question-bank", "destination": "/practice", "permanent": true },
    { "source": "/subject-progress", "destination": "/progress", "permanent": true },
    { "source": "/admin/users", "destination": "/admin/accounts", "permanent": true },
    { "source": "/admin/students", "destination": "/admin/accounts", "permanent": true },
    { "source": "/admin/admins", "destination": "/admin/accounts", "permanent": true }
  ],
  "headers": [
    {
      "source": "/assets/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }
      ]
    },
    {
      "source": "/index.html",
      "headers": [
        { "key": "Cache-Control", "value": "no-cache" }
      ]
    },
    {
      "source": "/auth",
      "headers": [
        { "key": "X-Robots-Tag", "value": "noindex, nofollow" }
      ]
    },
    {
      "source": "/auth/callback",
      "headers": [
        { "key": "X-Robots-Tag", "value": "noindex, nofollow" }
      ]
    },
    {
      "source": "/reset-password",
      "headers": [
        { "key": "X-Robots-Tag", "value": "noindex, nofollow" }
      ]
    },
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" },
        { "key": "X-Frame-Options", "value": "SAMEORIGIN" }
      ]
    }
  ]
}
