{
  "$schema": "https://vercel.com/schema/v6",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "framework": "vite",
  "rewrites": [{ "source": "/(.*)", "destination": "/spa-fallback.html" }],
  "redirects": [
    { "source": "/study/biology/igcse/:path*", "destination": "/study/biology/ol/:path*", "permanent": true },
    { "source": "/study/biology/igcse", "destination": "/study/biology/ol", "permanent": true },
    { "source": "/study/chemistry/igcse/:path*", "destination": "/study/chemistry/ol/:path*", "permanent": true },
    { "source": "/study/chemistry/igcse", "destination": "/study/chemistry/ol", "permanent": true },
    { "source": "/study/computer-science/igcse/:path*", "destination": "/study/computer-science/ol/:path*", "permanent": true },
    { "source": "/study/computer-science/igcse", "destination": "/study/computer-science/ol", "permanent": true },
    { "source": "/study/mathematics/igcse/:path*", "destination": "/study/mathematics/ol/:path*", "permanent": true },
    { "source": "/study/mathematics/igcse", "destination": "/study/mathematics/ol", "permanent": true },
    { "source": "/study/physics/igcse/:path*", "destination": "/study/physics/ol/:path*", "permanent": true },
    { "source": "/study/physics/igcse", "destination": "/study/physics/ol", "permanent": true },
    { "source": "/study/english-first-language-cambridge/ol/:path*", "destination": "/study/english-first-language-cambridge/igcse/:path*", "permanent": true },
    { "source": "/study/english-first-language-cambridge/ol", "destination": "/study/english-first-language-cambridge/igcse", "permanent": true },
    { "source": "/study/english-as-a-second-language-oxford/ol/:path*", "destination": "/study/english-as-a-second-language-oxford/igcse/:path*", "permanent": true },
    { "source": "/study/english-as-a-second-language-oxford/ol", "destination": "/study/english-as-a-second-language-oxford/igcse", "permanent": true },
    { "source": "/homework", "destination": "/quizzes", "permanent": true },
    { "source": "/revision", "destination": "/notes", "permanent": true },
    { "source": "/heatmap", "destination": "/progress", "permanent": true },
    { "source": "/review", "destination": "/practice", "permanent": true },
    { "source": "/smart-revision", "destination": "/practice", "permanent": true },
    { "source": "/subject-progress", "destination": "/progress", "permanent": true },
    { "source": "/admin/users", "destination": "/admin/accounts", "permanent": true },
    { "source": "/admin/students", "destination": "/admin/accounts", "permanent": true },
    { "source": "/admin/admins", "destination": "/admin/accounts", "permanent": true }
  ],
  "headers": [
    {
      "source": "/assets/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }
      ]
    },
    {
      "source": "/index.html",
      "headers": [
        { "key": "Cache-Control", "value": "no-cache" }
      ]
    },
    {
      "source": "/auth",
      "headers": [
        { "key": "X-Robots-Tag", "value": "noindex, nofollow" }
      ]
    },
    {
      "source": "/auth/callback",
      "headers": [
        { "key": "X-Robots-Tag", "value": "noindex, nofollow" }
      ]
    },
    {
      "source": "/reset-password",
      "headers": [
        { "key": "X-Robots-Tag", "value": "noindex, nofollow" }
      ]
    },
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" },
        { "key": "X-Frame-Options", "value": "SAMEORIGIN" },
        { "key": "Strict-Transport-Security", "value": "max-age=31536000; includeSubDomains" },
        { "key": "Cross-Origin-Opener-Policy", "value": "same-origin-allow-popups" },
        { "key": "Permissions-Policy", "value": "camera=(), microphone=(), geolocation=(), payment=(), usb=(), magnetometer=(), gyroscope=(), interest-cohort=()" },
        { "key": "Content-Security-Policy", "value": "default-src 'self'; script-src 'self' https://plausible.io; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob: https:; font-src 'self' data:; connect-src 'self' https://*.supabase.co wss://*.supabase.co https://api.pwnedpasswords.com https://plausible.io; frame-src 'self'; frame-ancestors 'self'; object-src 'none'; base-uri 'self'; form-action 'self' https://checkout.stripe.com; upgrade-insecure-requests" }
      ]
    }
  ]
}
